+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 < %s | FileCheck %s
+
+; The hazard recognizer can't see inside inline asm, so it treats inline asm that
+; defines an AGPR as a possible MFMA when the result is read.
+
+; An MFMA issued as inline asm (accumulator in AGPR) whose result is read right away.
+define amdgpu_kernel void @read_after_asm_mfma(ptr addrspace(1) %out, <8 x i32> %a, <8 x i32> %b) {
+; CHECK-LABEL: read_after_asm_mfma:
+; CHECK:       ; %bb.0:
+; CHECK-NEXT:    s_load_dwordx16 s[8:23], s[4:5], 0x20
+; CHECK-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
+; CHECK-NEXT:    v_accvgpr_write_b32 a0, 0
+; CHECK-NEXT:    v_mov_b32_e32 v16, 0
+; CHECK-NEXT:    v_accvgpr_mov_b32 a1, a0
+; CHECK-NEXT:    v_accvgpr_mov_b32 a2, a0
+; CHECK-NEXT:    v_accvgpr_mov_b32 a3, a0
+; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
+; CHECK-NEXT:    v_mov_b32_e32 v0, s8
+; CHECK-NEXT:    v_mov_b32_e32 v1, s9
+; CHECK-NEXT:    v_mov_b32_e32 v2, s10
+; CHECK-NEXT:    v_mov_b32_e32 v3, s11
+; CHECK-NEXT:    v_mov_b32_e32 v4, s12
+; CHECK-NEXT:    v_mov_b32_e32 v5, s13
+; CHECK-NEXT:    v_mov_b32_e32 v6, s14
+; CHECK-NEXT:    v_mov_b32_e32 v7, s15
+; CHECK-NEXT:    v_mov_b32_e32 v8, s16
+; CHECK-NEXT:    v_mov_b32_e32 v9, s17
+; CHECK-NEXT:    v_mov_b32_e32 v10, s18
+; CHECK-NEXT:    v_mov_b32_e32 v11, s19
+; CHECK-NEXT:    v_mov_b32_e32 v12, s20
+; CHECK-NEXT:    v_mov_b32_e32 v13, s21
+; CHECK-NEXT:    v_mov_b32_e32 v14, s22
+; CHECK-NEXT:    v_mov_b32_e32 v15, s23
+; CHECK-NEXT:    ;;#ASMSTART
+; CHECK-NEXT:    v_mfma_f32_16x16x128_f8f6f4 a[0:3], v[0:7], v[8:15], a[0:3]
+; CHECK-NEXT:    ;;#ASMEND
+; CHECK-NEXT:    s_nop 15
+; CHECK-NEXT:    s_nop 2
+; CHECK-NEXT:    global_store_dwordx4 v16, a[0:3], s[0:1]
+; CHECK-NEXT:    s_endpgm
+  %c = call <4 x float> asm sideeffect "v_mfma_f32_16x16x128_f8f6f4 $0, $1, $2, $0", "=a,v,v,0"(<8 x i32> %a, <8 x i32> %b, <4 x float> zeroinitializer)
+  store <4 x float> %c, ptr addrspace(1) %out
+  ret void
+}
+
+; A VALU write of the accumulator right before the inline-asm MFMA reads it.
+define amdgpu_kernel void @asm_mfma_after_valu_write(ptr addrspace(1) %out, <8 x i32> %a, <8 x i32> %b, float %x) {
+; CHECK-LABEL: asm_mfma_after_valu_write:
+; CHECK:       ; %bb.0:
+; CHECK-NEXT:    s_load_dword s2, s[4:5], 0x60
+; CHECK-NEXT:    s_load_dwordx16 s[8:23], s[4:5], 0x20
+; CHECK-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
+; CHECK-NEXT:    v_accvgpr_write_b32 a1, 0
+; CHECK-NEXT:    v_mov_b32_e32 v16, 0
+; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
+; CHECK-NEXT:    v_accvgpr_write_b32 a0, s2
+; CHECK-NEXT:    v_accvgpr_mov_b32 a2, a1
+; CHECK-NEXT:    v_accvgpr_mov_b32 a3, a1
+; CHECK-NEXT:    v_mov_b32_e32 v0, s8
+; CHECK-NEXT:    v_mov_b32_e32 v1, s9
+; CHECK-NEXT:    v_mov_b32_e32 v2, s10
